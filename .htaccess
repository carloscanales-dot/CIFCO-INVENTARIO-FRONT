<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ===============================================
  # MIME TYPES - CRÍTICO para módulos JavaScript
  # ===============================================
  <IfModule mod_mime.c>
    # JavaScript - PRIORIDAD MÁXIMA
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/javascript .js
    
    # CSS
    AddType text/css .css
    
    # JSON
    AddType application/json .json
    
    # Fuentes
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType font/ttf .ttf
    AddType font/eot .eot
    AddType font/otf .otf
    
    # Imágenes
    AddType image/svg+xml .svg
    AddType image/webp .webp
  </IfModule>

  # ===============================================
  # COMPRESIÓN GZIP
  # ===============================================
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  </IfModule>

  # ===============================================
  # HEADERS DE SEGURIDAD Y MIME
  # ===============================================
  <IfModule mod_headers.c>
    # Prevenir MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Cache para assets (1 año)
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # NO cachear index.html - CRÍTICO
    <FilesMatch "^index\.html$">
      Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
      Header set Pragma "no-cache"
      Header set Expires "0"
    </FilesMatch>
    
    # NO cachear HTML en general
    <FilesMatch "\.html$">
      Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
      Header set Pragma "no-cache"
      Header set Expires "0"
    </FilesMatch>
  </IfModule>

  # ===============================================
  # REGLAS DE REWRITE - ORDEN CRÍTICO PARA SPA
  # ===============================================
  
  # NO procesar archivos que existen físicamente
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  
  # NO procesar directorios que existen
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Redirigir TODAS las rutas restantes a index.html (Vue Router)
  # Esto es crítico para que /dashboard, /login, /dispatches, etc funcionen
  RewriteRule ^ index.html [L]
</IfModule>

# ===============================================
# DESHABILITAR LISTADO DE DIRECTORIOS
# ===============================================
Options -Indexes

# ===============================================
# CHARSET DEFAULT
# ===============================================
AddDefaultCharset UTF-8

# ===============================================
# DESHABILITAR LISTADO DE DIRECTORIOS
# ===============================================
Options -Indexes

# ===============================================
# CHARSET DEFAULT
# ===============================================
AddDefaultCharset UTF-8
